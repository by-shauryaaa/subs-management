{
  "name": "@brightloop/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:db": "prisma generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.db.config.mjs --runInBand",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma generate && tsc -p tsconfig.seed.json && node dist/seed/prisma/seed.js"
  },
  "dependencies": {
    "@brightloop/shared": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15"
  }
}
