{
  "name": "brightloop",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @brightloop/shared build && pnpm --parallel --filter @brightloop/api --filter @brightloop/web --filter @brightloop/shared dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @brightloop/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @brightloop/shared build && pnpm -r test",
    "test:db": "pnpm --filter @brightloop/api test:db",
    "db:generate": "pnpm --filter @brightloop/api db:generate",
    "db:validate": "pnpm --filter @brightloop/api db:validate",
    "db:migrate": "pnpm --filter @brightloop/api db:migrate",
    "db:deploy": "pnpm --filter @brightloop/api db:deploy",
    "db:status": "pnpm --filter @brightloop/api db:status",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
